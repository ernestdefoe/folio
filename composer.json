{
    "name": "ernestdefoe/folio",
    "description": "Export a Flarum discussion as a PDF, a Word document or Markdown — styled in the forum's colours, with only the posts the reader is allowed to see.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "export",
        "pdf",
        "docx",
        "markdown"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/ernestdefoe/folio",
    "support": {
        "forum": "https://discuss.flarum.org/d/39994-folio",
        "issues": "https://github.com/ernestdefoe/folio/issues",
        "source": "https://github.com/ernestdefoe/folio"
    },
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "dompdf/dompdf": "^3.1",
        "flarum/core": "^2.0",
        "league/html-to-markdown": "^5.1",
        "phpoffice/phpword": "^1.4"
    },
    "suggest": {
        "mpdf/mpdf": "Lets PDF exports contain Chinese, Japanese, Korean, Arabic, Hebrew and other scripts the default engine can't set."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Folio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Folio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Folio",
            "category": "feature",
            "icon": {
                "name": "fas fa-file-export",
                "backgroundColor": "#0f766e",
                "color": "#fff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0",
        "mpdf/mpdf": "^8.3"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
